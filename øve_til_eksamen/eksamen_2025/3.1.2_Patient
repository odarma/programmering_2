public class Patient extends Person{
	private Doctor regularGP;
	
	public Patient (String name, String birthNumber, Doctor regularGP){
		super(name,birthNumber);
		setRegularGP(regularGP);
	}
	
	public Patient (String name, double heightInCm, String birthNumber, Doctor regularGP){
		super(name,birthNumber,heightInCm);
		setRegularGP(regularGP);
	}
}